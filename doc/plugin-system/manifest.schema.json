{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NotepadNext unified plugin and marketplace metadata draft 0.2",
  "description": "Native Node plugin (list=false) or Marketplace catalog (list=array). Registration is metadata-only; the native API profile is 0.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "id",
    "name",
    "version",
    "list"
  ],
  "properties": {
    "manifestVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$",
      "description": "publisher.name; uniqueness and publisher identity require semantic checks."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "description": "Must be parsed as SemVer by the package validator; this schema checks the field type and length only."
    },
    "description": {
      "type": "string",
      "maxLength": 2048
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notepadnext",
        "api"
      ],
      "properties": {
        "notepadnext": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "api": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "description": "SemVer ranges checked against the application version and the native SDK API; wire protocol negotiation is separate."
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "entry"
      ],
      "properties": {
        "kind": {
          "const": "node"
        },
        "entry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$",
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          },
          "description": "Package-relative path using forward slashes. The installer must also resolve the real path, reject escaping symlinks and verify an existing regular file."
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "optional"
      ],
      "properties": {
        "required": {
          "$ref": "#/$defs/capabilityList"
        },
        "optional": {
          "$ref": "#/$defs/capabilityList"
        }
      },
      "description": "The host grants capabilities; this declaration is not an operating system sandbox. Lists must also be disjoint."
    },
    "activationEvents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 192,
        "pattern": "^(onStartup|onCommand:[a-zA-Z0-9_.-]+|onLanguage:[a-zA-Z0-9_.-]+)$"
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 192,
                "pattern": "^[a-zA-Z0-9_.-]+$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "icon": {
                "$ref": "#/$defs/iconPath"
              }
            }
          },
          "description": "Command IDs must be unique and start with the plugin ID followed by a dot; onCommand events must refer to declared commands."
        },
        "menus": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "location",
              "command"
            ],
            "properties": {
              "location": {
                "const": "plugins"
              },
              "command": {
                "$ref": "#/$defs/commandReference"
              },
              "order": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              }
            }
          },
          "description": "First native profile supports the host Plugins menu only. References must resolve to this plugin's declared commands; duplicate location/command pairs are rejected semantically."
        },
        "toolbar": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command"
            ],
            "properties": {
              "command": {
                "$ref": "#/$defs/commandReference"
              },
              "order": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              }
            }
          },
          "description": "Host-owned plugin toolbar buttons use the command's icon or a host fallback. Command references and duplicates require semantic validation."
        }
      }
    },
    "list": {
      "description": "The sole public type discriminator. false is one plugin; an array is a marketplace, including an empty marketplace. Missing, true, null and strings are invalid.",
      "oneOf": [
        {
          "const": false
        },
        {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/catalogPlugin"
          }
        }
      ]
    },
    "repository": {
      "type": "string",
      "maxLength": 8192,
      "pattern": "^(https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?|file:///[^?#]+)$",
      "description": "Canonical GitHub repository or local metadata file URI. Local registration resolves an omitted repository to its file URI; GitHub registration resolves it to the input repository. Marketplace plugin entries require a GitHub repository. A package claim cannot silently change the registered origin."
    },
    "displayIcon": {
      "type": "string",
      "enum": [
        "plugin",
        "markdown"
      ],
      "description": "Optional host-owned visual identity. It is available in Discover and before activation; package image files are read only after verification."
    },
    "category": {
      "enum": [
        "command",
        "editor-tool",
        "editor-preview",
        "window-tool",
        "background-service"
      ],
      "description": "Purpose and native component ownership, independent of activation and capabilities."
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewType",
        "languages",
        "extensions"
      ],
      "properties": {
        "viewType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "maxItems": 16,
          "uniqueItems": true
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\.[a-z0-9]+$"
          },
          "maxItems": 16,
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "commandReference": {
      "type": "string",
      "maxLength": 192,
      "pattern": "^[a-zA-Z0-9_.-]+$"
    },
    "iconPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*\\.png$",
      "not": {
        "pattern": "(^|/)\\.\\.(/|$)"
      },
      "description": "First profile uses package-relative PNG icons. Real-path containment, file existence and image byte/dimension limits must be checked by the installer."
    },
    "capabilityList": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)*@[1-9][0-9]*$"
      }
    },
    "catalogPlugin": {
      "allOf": [
        {
          "$ref": "#"
        },
        {
          "properties": {
            "repository": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?$"
            },
            "list": {
              "const": false
            }
          },
          "required": [
            "repository"
          ]
        }
      ],
      "description": "Same plugin metadata, with a release repository. Nested marketplaces are not supported in this draft."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "list": {
            "const": false
          }
        },
        "required": [
          "list"
        ]
      },
      "then": {
        "required": [
          "engines",
          "runtime",
          "capabilities",
          "activationEvents"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "engines"
              ]
            },
            {
              "required": [
                "runtime"
              ]
            },
            {
              "required": [
                "capabilities"
              ]
            },
            {
              "required": [
                "activationEvents"
              ]
            },
            {
              "required": [
                "contributes"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "editor-preview"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "required": [
          "preview"
        ]
      },
      "else": {
        "not": {
          "required": [
            "preview"
          ]
        }
      }
    }
  ]
}
