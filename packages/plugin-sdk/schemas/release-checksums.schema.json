{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NotepadNext plugin release checksums, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pluginId", "version", "assets"],
  "properties": {
    "schemaVersion": {"const": 1},
    "pluginId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}(?![\\s\\S])"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"},
    "assets": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "size", "sha256"],
        "properties": {
          "name": {"type": "string", "pattern": "^notepadnext-plugin(?:-(?:macos|windows|linux)-(?:x64|arm64))?\\.zip(?![\\s\\S])"},
          "size": {"type": "integer", "minimum": 1, "maximum": 134217728},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}(?![\\s\\S])"}
        }
      }
    }
  },
  "$comment": "Native validation also requires unique asset names and equality with the registered plugin ID/version and reviewed ZIP size; total file size is limited to 64 KiB."
}
