{
  "manifestVersion": 1,
  "id": "__PLUGIN_ID__",
  "name": "Hello Plugin",
  "version": "0.1.0",
  "list": false,
  "description": "A minimal command plugin generated by the SDK.",
  "engines": {
    "notepadnext": ">=0.15.0 <0.16.0",
    "api": "^0.1.0"
  },
  "runtime": {
    "kind": "node",
    "entry": "dist/index.js"
  },
  "capabilities": {
    "required": [
      "commands@1",
      "messages@1"
    ],
    "optional": []
  },
  "activationEvents": [
    "onCommand:__PLUGIN_ID__.open"
  ],
  "contributes": {
    "commands": [
      {
        "id": "__PLUGIN_ID__.open",
        "title": "Say Hello"
      }
    ],
    "menus": [
      {
        "location": "plugins",
        "command": "__PLUGIN_ID__.open",
        "order": 100
      }
    ]
  }
}
