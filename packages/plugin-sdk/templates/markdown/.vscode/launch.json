{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "SDK simulated host",
      "program": "${workspaceFolder}/node_modules/@notepadnext/plugin-sdk/debug.cjs",
      "args": [
        ".",
        "--input",
        "demo.md",
        "--output",
        ".debug/preview.html"
      ],
      "cwd": "${workspaceFolder}",
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach SDK debug:break",
      "address": "127.0.0.1",
      "port": 9229,
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
