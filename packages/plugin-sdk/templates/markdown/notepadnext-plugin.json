{
  "manifestVersion": 1,
  "id": "__PLUGIN_ID__",
  "name": "Markdown Preview",
  "version": "0.1.0",
  "list": false,
  "description": "Preview the current Markdown buffer, including unsaved edits.",
  "engines": {
    "notepadnext": ">=0.15.0 <0.16.0",
    "api": "^0.1.0"
  },
  "runtime": {
    "kind": "node",
    "entry": "dist/index.js"
  },
  "capabilities": {
    "required": [
      "documents.read@1",
      "documents.events@1",
      "commands@1",
      "webviews@1",
      "webviews.restore@1"
    ],
    "optional": []
  },
  "activationEvents": [
    "onCommand:__PLUGIN_ID__.open"
  ],
  "contributes": {
    "commands": [
      {
        "id": "__PLUGIN_ID__.open",
        "title": "Open Markdown Preview"
      }
    ],
    "menus": [
      {
        "location": "plugins",
        "command": "__PLUGIN_ID__.open",
        "order": 100
      }
    ],
    "toolbar": [
      {
        "command": "__PLUGIN_ID__.open",
        "order": 100
      }
    ]
  },
  "displayIcon": "markdown"
}
