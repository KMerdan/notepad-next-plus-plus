if(NOT TARGET ZLIB::ZLIB)
    option(NOTEPADNEXT_BUNDLED_ZLIB "Use the pinned static zlib instead of a system zlib" OFF)
    set(NOTEPADNEXT_ZLIB_ARCHIVE "" CACHE FILEPATH "Optional offline zlib 1.3.2 archive, verified against the pinned hash")
    if(NOT NOTEPADNEXT_BUNDLED_ZLIB)
        find_package(ZLIB QUIET)
    endif()
    if(TARGET ZLIB::ZLIB)
        set_target_properties(ZLIB::ZLIB PROPERTIES IMPORTED_GLOBAL TRUE)
    else()
        # Verified official archive. No dependency on a Windows package manager;
        # plugin-disabled builds do not enter this module.
        include(FetchContent)
        if(POLICY CMP0135)
            cmake_policy(SET CMP0135 NEW)
        endif()
        enable_language(C)
        set(plugin_zlib_url
            "https://github.com/madler/zlib/releases/download/v1.3.2/zlib-1.3.2.tar.gz"
            "https://zlib.net/fossils/zlib-1.3.2.tar.gz")
        if(NOTEPADNEXT_ZLIB_ARCHIVE)
            set(plugin_zlib_url "${NOTEPADNEXT_ZLIB_ARCHIVE}")
        endif()
        FetchContent_Declare(nnp_zlib
            URL ${plugin_zlib_url}
            URL_HASH SHA256=bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16)
        set(ZLIB_BUILD_TESTING OFF CACHE BOOL "Build zlib examples as tests" FORCE)
        set(ZLIB_BUILD_SHARED OFF CACHE BOOL "Build shared zlib" FORCE)
        set(ZLIB_BUILD_STATIC ON CACHE BOOL "Build static zlib" FORCE)
        set(ZLIB_INSTALL OFF CACHE BOOL "Install zlib separately" FORCE)
        set(ZLIB_PREFIX OFF CACHE BOOL "Prefix zlib ABI symbols" FORCE)
        FetchContent_MakeAvailable(nnp_zlib)
        set_target_properties(zlibstatic PROPERTIES POSITION_INDEPENDENT_CODE TRUE)
        add_library(ZLIB::ZLIB ALIAS zlibstatic)
        set_property(GLOBAL PROPERTY NNP_PLUGIN_BUNDLED_ZLIB TRUE)
    endif()
endif()
